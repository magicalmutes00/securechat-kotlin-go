# Release signing — copy to android/keystore.properties (gitignored).
#
# app/build.gradle.kts reads this file. When it is absent the release variant is
# left UNSIGNED on purpose, so `bundleRelease` cannot silently produce an
# artifact that fails to upload to Play. Debug builds fall back to the local
# ~/.android/securechat.keystore.
#
# Generate a real upload key (never reuse the debug keystore):
#   keytool -genkeypair -v -keystore upload.jks -alias upload \
#           -keyalg RSA -keysize 4096 -validity 10000

storeFile=/absolute/path/to/upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME

# Optional: override the local debug keystore credentials.
# debugStorePassword=securechat
# debugKeyAlias=securechat
# debugKeyPassword=securechat
