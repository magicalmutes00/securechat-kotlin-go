<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only network policy. This file overrides the src/main copy for debug
  builds, so cleartext LAN access and user-installed CAs are impossible to ship
  in a release.

  Cleartext hosts must be named individually: <domain> matches hostnames, not IP
  ranges. Add your machine's LAN address (e.g. 192.168.1.50) to test against a
  local server — a CIDR block such as 192.168.0.0/16 does nothing.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Local development servers. -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Host machine as seen from the Android emulator. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- Add the LAN IP of the development machine here, e.g.:
        <domain includeSubdomains="false">192.168.1.50</domain>
        -->
    </domain-config>

    <!-- Trust user-installed CAs so a debugging proxy can inspect traffic. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
