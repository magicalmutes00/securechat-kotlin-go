<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy (API < 31) full-backup rules.

  The shared-preferences filename must match the name passed to
  EncryptedSharedPreferences.create(...) in AppModule, which is
  "securechat_secure_prefs" — the previous entries ("securechat_prefs.xml",
  "EncryptedPreferences.xml") excluded files that never existed, so the token
  store was in fact eligible for backup.
-->
<full-backup-content>
    <!-- Exclude sensitive data from backup -->
    <exclude domain="sharedpref" path="securechat_secure_prefs.xml" />
    <exclude domain="database" path="securechat.db" />
    <exclude domain="database" path="securechat.db-shm" />
    <exclude domain="database" path="securechat.db-wal" />
    <exclude domain="file" path="keystore" />
</full-backup-content>
