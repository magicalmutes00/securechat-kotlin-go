<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="securechat_prefs.xml" />
        <exclude domain="sharedpref" path="EncryptedPreferences.xml" />
        <exclude domain="database" path="securechat.db" />
        <exclude domain="database" path="securechat.db-shm" />
        <exclude domain="database" path="securechat.db-wal" />
        <exclude domain="file" path="keystore" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="securechat_prefs.xml" />
        <exclude domain="sharedpref" path="EncryptedPreferences.xml" />
        <exclude domain="database" path="securechat.db" />
        <exclude domain="database" path="securechat.db-shm" />
        <exclude domain="database" path="securechat.db-wal" />
        <exclude domain="file" path="keystore" />
    </device-transfer>
</data-extraction-rules>