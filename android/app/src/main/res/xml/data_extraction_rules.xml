<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup / device-transfer rules.

  The shared-preferences filename must match EncryptedSharedPreferences.create
  in AppModule ("securechat_secure_prefs"); the old paths named files that were
  never created, leaving the token store transferable.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="securechat_secure_prefs.xml" />
        <exclude domain="database" path="securechat.db" />
        <exclude domain="database" path="securechat.db-shm" />
        <exclude domain="database" path="securechat.db-wal" />
        <exclude domain="file" path="keystore" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="securechat_secure_prefs.xml" />
        <exclude domain="database" path="securechat.db" />
        <exclude domain="database" path="securechat.db-shm" />
        <exclude domain="database" path="securechat.db-wal" />
        <exclude domain="file" path="keystore" />
    </device-transfer>
</data-extraction-rules>
