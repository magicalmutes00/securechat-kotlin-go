<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Development: allow cleartext for LAN IPs -->
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">10.0.0.0/8</domain>
        <domain includeSubdomains="true">192.168.0.0/16</domain>
        <domain includeSubdomains="true">172.16.0.0/12</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>

    <domain-config cleartextTrafficPermitted="false">
        <!-- Production: enforce HTTPS -->
        <domain includeSubdomains="true">securechat-api.onrender.com</domain>
        <domain includeSubdomains="true">api.securechat.app</domain>
        <domain includeSubdomains="true">securechat.app</domain>
    </domain-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>