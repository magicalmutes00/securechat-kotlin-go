# Server Configuration
SECURECHAT_SERVER_HOST=0.0.0.0
SECURECHAT_SERVER_PORT=8080
SECURECHAT_ENVIRONMENT=development

# MySQL Database (TiDB Cloud is MySQL-compatible and works with go-sql-driver)
SECURECHAT_MYSQL_HOST=gateway01.region.tidbcloud.com
SECURECHAT_MYSQL_PORT=4000
SECURECHAT_MYSQL_DATABASE=securechat
SECURECHAT_MYSQL_USER=your_tidb_user
SECURECHAT_MYSQL_PASSWORD=your_tidb_password
SECURECHAT_MYSQL_TLS=true
SECURECHAT_MYSQL_MAX_OPEN_CONNS=25
SECURECHAT_MYSQL_MAX_IDLE_CONNS=5
SECURECHAT_MYSQL_CONN_MAX_LIFETIME=300

# JWT Authentication (base64-encoded RSA private keys, one per line)
SECURECHAT_JWT_ACCESS_SECRET=base64_encoded_rsa_private_key_for_access_tokens
SECURECHAT_JWT_REFRESH_SECRET=base64_encoded_rsa_private_key_for_refresh_tokens
SECURECHAT_JWT_ACCESS_TTL=900
SECURECHAT_JWT_REFRESH_TTL=2592000
SECURECHAT_JWT_ISSUER=securechat
SECURECHAT_JWT_AUDIENCE=securechat-android

# OTP Configuration (mock for local dev, twilio for production)
SECURECHAT_OTP_PROVIDER=mock
SECURECHAT_OTP_LENGTH=6
SECURECHAT_OTP_TTL=300
SECURECHAT_OTP_MAX_ATTEMPTS=5
SECURECHAT_OTP_RESEND_COOLDOWN=60
SECURECHAT_OTP_TWILIO_ACCOUNT_SID=
SECURECHAT_OTP_TWILIO_AUTH_TOKEN=
SECURECHAT_OTP_TWILIO_FROM_NUMBER=

# Cloudinary Media Storage
SECURECHAT_CLOUDINARY_CLOUD_NAME=your_cloud_name
SECURECHAT_CLOUDINARY_API_KEY=your_api_key
SECURECHAT_CLOUDINARY_API_SECRET=your_api_secret
SECURECHAT_CLOUDINARY_UPLOAD_FOLDER=securechat
SECURECHAT_CLOUDINARY_MAX_IMAGE_MB=20
SECURECHAT_CLOUDINARY_MAX_VIDEO_MB=500
SECURECHAT_CLOUDINARY_MAX_AUDIO_MB=50
SECURECHAT_CLOUDINARY_MAX_DOCUMENT_MB=100

# Ollama AI (Optional)
SECURECHAT_OLLAMA_URL=http://localhost:11434
SECURECHAT_OLLAMA_API_KEY=
SECURECHAT_OLLAMA_DEFAULT_MODEL=llama3.1:8b
SECURECHAT_OLLAMA_TIMEOUT=30

# Logging
SECURECHAT_LOG_LEVEL=info
SECURECHAT_LOG_FORMAT=json